<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_equipment_loan_check_overdue" model="ir.cron">
        <field name="name">Equipment Loan: Check Overdue</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_equipment_loan_due_date_reminder" model="ir.cron">
        <field name="name">Equipment Loan: Send Due Date Reminder (H-1)</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due_date_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>