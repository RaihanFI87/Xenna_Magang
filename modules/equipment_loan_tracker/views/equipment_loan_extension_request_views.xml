<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_extension_request_list" model="ir.ui.view">
        <field name="name">equipment.loan.extension.request.list</field>
        <field name="model">equipment.loan.extension.request</field>
        <field name="arch" type="xml">
            <list string="Extension Requests">
                <field name="loan_id"/>
                <field name="requested_due_date"/>
                <field name="reason"/>
                <field name="state"/>
                <field name="reviewed_by"/>
            </list>
        </field>
    </record>

    <record id="view_extension_request_form" model="ir.ui.view">
        <field name="name">equipment.loan.extension.request.form</field>
        <field name="model">equipment.loan.extension.request</field>
        <field name="arch" type="xml">
            <form string="Extension Request">
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        invisible="state != 'pending'"
                    />
                    <button
                        name="action_reject"
                        type="object"
                        string="Reject"
                        class="btn-secondary"
                        invisible="state != 'pending'"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="loan_id" readonly="1"/>
                        <field name="requested_due_date"/>
                        <field name="reason"/>
                        <field name="reviewed_by" readonly="1"/>
                        <field name="reviewed_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_extension_request" model="ir.actions.act_window">
        <field name="name">Extension Requests</field>
        <field name="res_model">equipment.loan.extension.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>