<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="borrower_view_list" model="ir.ui.view">
        <field name="name">res.partner.borrower.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Borrower">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="borrower_view_form" model="ir.ui.view">
        <field name="name">res.partner.borrower.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Borrower">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                        </group>

                        <group>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="type"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="borrower_view_search" model="ir.ui.view">
        <field name="name">res.partner.borrower.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Cari Borrower">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </search>
        </field>
    </record>

    <record id="borrower_action" model="ir.actions.act_window">
        <field name="name">Borrower</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="borrower_view_search"/>
    </record>

</odoo>