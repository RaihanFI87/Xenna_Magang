<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="equipment_loan_portal_rule" model="ir.rule">
        <field name="name">Equipment Loan: Portal user hanya lihat/buat miliknya sendiri</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="domain_force">[('borrower_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="equipment_loan_line_portal_rule" model="ir.rule">
        <field name="name">Equipment Loan Line: Portal user hanya lihat/buat miliknya sendiri</field>
        <field name="model_id" ref="model_equipment_loan_line"/>
        <field name="domain_force">[('loan_id.borrower_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>
    <record id="equipment_loan_extension_request_portal_rule" model="ir.rule">
        <field name="name">Extension Request: Portal user hanya miliknya sendiri</field>
        <field name="model_id" ref="model_equipment_loan_extension_request"/>
        <field name="domain_force">[('loan_id.borrower_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>