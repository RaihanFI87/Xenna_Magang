<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="data_siswa_view_list" model="ir.ui.view">
            <field name="name">data_siswa_view_list</field>
            <field name="model">data.siswa</field>
            <field name="arch" type="xml">
                <list string="List Data Siswa">
                    <field name="nis"/>
                    <field name="name"/>
                    <field name="umur"/>
                    <field name="kelas"/>
                    <field name="tempat_lahir"/>
                    <field name="tanggal_lahir"/>
                </list>
            </field>
        </record>

        <record id="data_siswa_view_form" model="ir.ui.view">
            <field name="name">data_siswa_view_form</field>
            <field name="model">data.siswa</field>
            <field name="arch" type="xml">
                <form string="data_siswa_form">
                    <sheet>
                        <group>
                            <field name="nis"/>
                            <field name="name"/>
                            <field name="umur"/>
                            <field name="kelas"/>
                            <field name="tempat_lahir"/>
                            <field name="tanggal_lahir"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="data_siswa_action" model="ir.actions.act_window">
            <field name="name">Data Siswa</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">data.siswa</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_item_data_siswa" name="Data Siswa" parent="perpustakaan.menu_item_perpustakaan" action="data_siswa_action" sequence="10"/>
    </data>
</odoo>